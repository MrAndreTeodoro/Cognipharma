    <script>
        // Tab switching functionality
        function switchTab(tabId) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('block');
                content.classList.add('hidden');
            });

            // Remove active class from all buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.remove('border-primary');
                btn.classList.remove('text-primary');
                btn.classList.add('border-transparent');
                btn.classList.add('text-text-light');
            });

            // Show selected tab
            const selectedTab = document.getElementById(tabId);
            selectedTab.classList.remove('hidden');
            selectedTab.classList.add('block');

            // Add active class to clicked button
            event.target.classList.add('active');
            event.target.classList.remove('border-transparent');
            event.target.classList.remove('text-text-light');
            event.target.classList.add('border-primary');
            event.target.classList.add('text-primary');
        }

        // Accordion functionality
        function toggleAccordion(header) {
            const item = header.parentElement;
            const isActive = item.classList.contains('active');

            // Close all items
            document.querySelectorAll('.accordion-item').forEach(acc => {
                acc.classList.remove('active');
            });

            // Open clicked item if it wasn't active
            if (!isActive) {
                item.classList.add('active');
            }
        }

        // Resource filtering
        function filterResources(type) {
            const cards = document.querySelectorAll('.resource-card');
            const buttons = document.querySelectorAll('.filter-bar .filter-btn');

            // Update button states
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // Filter cards
            cards.forEach(card => {
                if (type === 'all' || card.dataset.type === type) {
                    card.style.display = 'block';
                    card.style.animation = 'fadeIn 0.3s ease';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // FAQ filtering
        function filterFAQ(category) {
            const items = document.querySelectorAll('.accordion-item');
            const buttons = document.querySelectorAll('#faq .filter-btn');

            // Update button states
            buttons.forEach(btn => btn.classList.remove('active', 'bg-primary', 'text-white', 'border-primary'));
            buttons.forEach(btn => btn.classList.add('bg-white', 'text-text-light', 'border-border'));
            event.target.classList.add('active', 'bg-primary', 'text-white', 'border-primary');
            event.target.classList.remove('bg-white', 'text-text-light', 'border-border');

            // Filter FAQ items
            items.forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Sticky nav active state on scroll
        window.addEventListener('scroll', () => {
            const sections = document.querySelectorAll('.section');
            const navLinks = document.querySelectorAll('.sticky-nav a');

            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (scrollY >= sectionTop - 200) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === `#${current}`) {
                    link.classList.add('active');
                }
            });
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Action buttons
        function saveForLater() {
            alert('Conteúdo guardado na sua área pessoal!');
        }

        function shareContent() {
            if (navigator.share) {
                navigator.share({
                    title: 'CogniThera - Nova Opção Terapêutica',
                    text: 'Informação sobre CogniThera para carcinoma de células renais',
                    url: window.location.href
                });
            } else {
                alert('Link copiado para a área de transferência!');
            }
        }

        function downloadPDF() {
            alert('A iniciar download do resumo clínico...');
        }

        function contactMedical() {
            alert('Redirecionando para o formulário de contacto Medical Information...');
        }

        function scheduleVisit() {
            alert('Calendário de visitas aberto. Selecione uma data disponível.');
        }

        // Add animation styles
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
        `;
        document.head.appendChild(style);
    </script>
